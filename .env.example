# Domain pointing at this server (A/AAAA record). Caddy fetches the HTTPS certificate.
DOMAIN=cutline.example.com

# Long random secret for login tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Optional: log users out after this many minutes without activity (default 60),
# and at the latest this many days after they logged in (default 30)
# IDLE_TIMEOUT_MINUTES=60
# SESSION_MAX_DAYS=30

# Optional: use PostgreSQL instead of the built-in SQLite database (stored in the data volume)
# DATABASE_URL=postgresql://user:password@host:5432/cutline
